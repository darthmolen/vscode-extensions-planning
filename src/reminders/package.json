{
  "name": "reminders",
  "displayName": "Reminders",
  "description": "Surfaces set-reminders markdown files as a status bar count, a quick pick, and a panel view.",
  "version": "0.2.0",
  "publisher": "pyquest",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "reminders.panel",
          "title": "Reminders",
          "icon": "media/bell.svg"
        }
      ]
    },
    "views": {
      "reminders.panel": [
        {
          "id": "reminders.view",
          "name": "Reminders",
          "contextualTitle": "Reminders"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "reminders.view",
        "contents": "Nothing outstanding.\n\nA reminder records work a person must do, which no test will ever notice was skipped.\n\n[Refresh](command:reminders.refresh)"
      }
    ],
    "commands": [
      {
        "command": "reminders.show",
        "title": "Reminders: Show Open Reminders"
      },
      {
        "command": "reminders.refresh",
        "title": "Reminders: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "reminders.openReminder",
        "title": "Reminders: Open Reminder"
      },
      {
        "command": "reminders.openMalformed",
        "title": "Reminders: Open Unparsed File"
      },
      {
        "command": "reminders.openPlan",
        "title": "Open the plan",
        "icon": "$(link-external)"
      },
      {
        "command": "reminders.close",
        "title": "Close, with a note",
        "icon": "$(check)"
      },
      {
        "command": "reminders.drop",
        "title": "Drop, with a reason",
        "icon": "$(circle-slash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "reminders.refresh",
          "when": "view == reminders.view",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "reminders.openPlan",
          "when": "view == reminders.view && viewItem == reminderWithPlan",
          "group": "inline@1"
        },
        {
          "command": "reminders.close",
          "when": "view == reminders.view && viewItem =~ /^reminder(WithPlan)?$/",
          "group": "inline@2"
        },
        {
          "command": "reminders.drop",
          "when": "view == reminders.view && viewItem =~ /^reminder(WithPlan)?$/",
          "group": "context@1"
        }
      ],
      "commandPalette": [
        {
          "command": "reminders.openReminder",
          "when": "false"
        },
        {
          "command": "reminders.openMalformed",
          "when": "false"
        },
        {
          "command": "reminders.openPlan",
          "when": "false"
        },
        {
          "command": "reminders.close",
          "when": "false"
        },
        {
          "command": "reminders.drop",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Reminders",
      "properties": {
        "reminders.directory": {
          "type": "string",
          "default": "planning/reminders",
          "markdownDescription": "Directory holding the reminder files, **relative to the workspace root**. Absolute paths are not supported in v1."
        },
        "reminders.groupBy": {
          "type": "string",
          "enum": [
            "subject",
            "audience",
            "category",
            "flat"
          ],
          "default": "subject",
          "description": "Which field groups the list."
        },
        "reminders.openStatus": {
          "type": "string",
          "default": "open",
          "markdownDescription": "The `**Status:**` value that counts as outstanding. The vocabulary belongs to the skill, not to this extension."
        },
        "reminders.warnOnAudience": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "learner"
          ],
          "markdownDescription": "Audiences that turn the status bar amber. A reminder addressed to the learner happens during a session, in their time, and competes with the teaching."
        },
        "reminders.statusBarPriority": {
          "type": "number",
          "default": 49,
          "markdownDescription": "Status bar priority. Higher is further left. VS Code registers Problems at 50, so 49 sits just right of it — observed, not contracted, which is why this is a setting."
        },
        "reminders.closedLabel": {
          "type": "string",
          "default": "Closed",
          "markdownDescription": "The bold label written beneath `**Status:**` when a reminder is closed. Must match whatever `SKILL.md` specifies."
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
